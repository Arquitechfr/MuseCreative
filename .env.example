# Firebase Client (à remplir avec vos credentials Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Brevo (envoi d'emails de feedback)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notifications@example.com
BREVO_SENDER_NAME=Votre App
FEEDBACK_EMAIL=contact@example.com

# Liste d'attente "Muse de la stratégie" : ID de la liste de contacts Brevo
# (si vide, chaque inscription est envoyée par email à FEEDBACK_EMAIL)
BREVO_WAITLIST_LIST_ID=
